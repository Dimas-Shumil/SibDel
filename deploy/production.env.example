# TEMPLATE ONLY: copy manually to a NEW private .env; never overwrite existing secrets.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
TRUST_PROXY=1
DATABASE_URL="postgresql://APP_ROLE:ENCODED_PASSWORD@127.0.0.1:5432/CONFIRMED_DATABASE?schema=public"
APP_NAME="Сибирские Деликатесы"
APP_URL="https://sib-del.ru"
SEO_SITE_URL="https://sib-del.ru"
SESSION_COOKIE_NAME=sibdel_session
SESSION_SECRET=replace_with_64_or_more_random_characters
SESSION_TTL_DAYS=30
# Customer idle lifetime; administrative sessions keep SESSION_TTL_DAYS.
CUSTOMER_SESSION_TTL_DAYS=90
LOG_LEVEL=info
UPLOAD_MAX_FILE_SIZE_MB=8
UPLOAD_MAX_FILES=10
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
SMTP_HOST=REPLACE_SMTP
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REPLACE_USER
SMTP_PASS=REPLACE_PASSWORD
TO_EMAIL=replace@example.invalid
