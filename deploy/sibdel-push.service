# Replace APP_USER, APP_GROUP, APP_DIR and NODE_BINARY; never copy over an existing unit blindly.
[Unit]
Description=SibDel scheduled campaigns and Web Push outbox
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=APP_USER
Group=APP_GROUP
WorkingDirectory=APP_DIR
Environment=NODE_ENV=production
Environment=DOTENV_CONFIG_PATH=APP_DIR/.env
ExecStart=NODE_BINARY APP_DIR/scripts/process-push.mjs 100
TimeoutStartSec=20min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
