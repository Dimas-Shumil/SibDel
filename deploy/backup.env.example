# Shell syntax, no secrets. Private file readable by the backup service user.
# PostgreSQL libpq service and password files must be mode 0600.
PGSERVICE=sibdel_backup
PGSERVICEFILE=/etc/sibdel/pg_service.conf
PGPASSFILE=/etc/sibdel/pgpass
APP_DIR=/REPLACE/APP_DIR
BACKUP_DIR=/REPLACE/PRIVATE_BACKUP_DIR
RETENTION_DAYS=14
