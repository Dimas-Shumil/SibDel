{
  "name": "siberian-delicacies",
  "version": "1.0.0",
  "private": true,
  "description": "E-commerce platform Siberian Delicacies",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "admin:create-owner": "node prisma/create-owner.js",
    "scss": "sass --no-source-map --style=expanded site/scss:site/css && sass --no-source-map --style=compressed site/scss/main.scss:site/css/main.min.css site/scss/catalog.scss:site/css/catalog.min.css site/scss/product.scss:site/css/product.min.css site/scss/cart.scss:site/css/cart.min.css site/scss/checkout.scss:site/css/checkout.min.css site/scss/account.scss:site/css/account.min.css site/scss/admin.scss:site/css/admin.min.css",
    "css": "npm run scss",
    "scss:watch": "sass --watch --no-source-map --style=compressed site/scss/main.scss:site/css/main.min.css site/scss/catalog.scss:site/css/catalog.min.css site/scss/product.scss:site/css/product.min.css site/scss/cart.scss:site/css/cart.min.css site/scss/checkout.scss:site/css/checkout.min.css site/scss/account.scss:site/css/account.min.css site/scss/admin.scss:site/css/admin.min.css",
    "css:watch": "npm run scss:watch",
    "security:audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.3.0",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.4",
    "swiper": "^14.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^7.10.0",
    "sass": "^1.103.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.23.1"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
