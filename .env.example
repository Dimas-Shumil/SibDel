NODE_ENV=development
PORT=3000
HOST=127.0.0.1

DATABASE_URL="postgresql://postgres:password@localhost:5432/siberian_delicacies?schema=public"

APP_NAME="Сибирские Деликатесы"
APP_URL="http://localhost:3000"

SESSION_COOKIE_NAME=sibdel_session
SESSION_SECRET=replace_with_random_secret_at_least_64_characters_long
SESSION_TTL_DAYS=30

TRUST_PROXY=0

UPLOAD_MAX_FILE_SIZE_MB=8
UPLOAD_MAX_FILES=10
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

LOG_LEVEL=info

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=example@example.com
SMTP_PASS=replace_with_real_password
# SMTP_FROM="Siberian Delicacies <example@example.com>"

TO_EMAIL=example@example.com
